#!/usr/bin/env bash
set -euo pipefail
umask 077

fail() { printf 'slurm-utils: %s\n' "$*" >&2; exit 1; }
help() {
    cat <<'HELP'
Usage: slurm-utils [--config PATH] schedule|status|connect|set-up|jupyter|cancel
       slurm-utils [--config PATH] schedule [--vmem GB]
       slurm-utils [--config PATH] jupyter [PORT]

Track one Slurm allocation. Configuration defaults to
~/.config/slurm-utils/config.sh (trusted Bash code).
Existing allocations use saved settings, without loading configuration again.
schedule --vmem 30 discovers GPU types with at least 30 GB of nominal VRAM,
prints scheduling estimates, and submits one request for the earliest type.
The chosen type remains fixed while queued. This overrides the type in GRES.
connect preserves your current directory and prefers zsh (falls back to Bash).
When available, login-node tmux keeps the connection alive; new windows and
panes connect to the same allocation. Run connect again to reattach.
set-up prepares .venv, direnv, and zsh in this directory inside a running job,
asking for confirmation before each change. Jupyter defaults to port 1234.
set-up can optionally install Notebook/ipykernel and register the .venv kernel.
HELP
}

validate_port() {
    if [[ ! $1 =~ ^[1-9][0-9]{0,4}$ ]] || (($1 > 65535)); then
        fail 'Jupyter port must be an integer from 1 to 65535'
    fi
}

# These functions are copied into the submitted script; no installed executable
# is required on the compute node.
batch_main() {
    local root scratch='' temp renewal='' sleeper=''
    for root in "${SCRATCH_ROOTS[@]}"; do
        if [[ -d $root && -w $root ]] &&
            mkdir -p -- "$root/$LAUNCH_USER/$SLURM_JOB_ID"; then
            scratch="$root/$LAUNCH_USER/$SLURM_JOB_ID"
            [[ -w $scratch ]] && break
            scratch=''
        fi
    done
    [[ -n $scratch ]] || { echo 'No usable configured scratch root' >&2; exit 1; }
    export SCRATCH_DIR=$scratch
    temp=$(mktemp "$LAUNCH_DIR/.scratch.XXXXXX")
    printf '%s\n' "$scratch" > "$temp"
    mv -- "$temp" "$LAUNCH_DIR/scratch-$SLURM_JOB_ID"
    # Invoked by the EXIT trap in the generated batch script.
    # shellcheck disable=SC2329
    cleanup() {
        [[ -z $renewal ]] || kill "$renewal" 2>/dev/null || true
        [[ -z $sleeper ]] || kill "$sleeper" 2>/dev/null || true
    }
    trap cleanup EXIT
    trap 'exit 0' TERM INT
    if [[ -n $KEYTAB && -f $KEYTAB ]] && command -v k5start >/dev/null; then
        k5start -U -f "$KEYTAB" -K 60 -l 10h &
        renewal=$!
        sleep 1
        if ! kill -0 "$renewal" 2>/dev/null; then
            echo 'k5start renewal startup failed; continuing without renewal' >&2
            wait "$renewal" || true
            renewal=''
        fi
    fi
    while :; do sleep 3600 & sleeper=$!; wait "$sleeper"; done
}

connect_tmux() {
    local session="slurm-utils-$JOB_ID-${LAUNCH_DIR##*.}"
    local launcher bash_path default_command
    bash_path=$(command -v bash)
    # Serialize creation, but never leave the lock open in the tmux server.
    exec 9> "$LAUNCH_DIR/connect.lock"
    flock -x 9
    if ! tmux has-session -t "=$session" 9>&- 2>/dev/null; then
        launcher=$(mktemp "$LAUNCH_DIR/connect.XXXXXXXX")
        {
            printf '#!/usr/bin/env bash\nset -euo pipefail\n'
            # A pre-existing tmux server may have an older module/PATH setup.
            printf 'export PATH=%q\n' "$PATH"
            printf 'exec '
            printf '%q ' "$@"
            printf '\n'
        } > "$launcher"
        printf -v default_command 'exec %q %q' "$bash_path" "$launcher"
        # The first pane receives argv directly; subsequent panes use Bash to
        # interpret the quoted command. Options apply only to this session.
        tmux new-session -d -s "$session" -c "$caller_dir" "$bash_path" "$launcher" \; \
            set-option -t "$session" default-shell "$bash_path" \; \
            set-option -t "$session" default-command "$default_command" 9>&- ||
            fail 'Could not create the compute tmux session'
    fi
    exec 9>&-
    if [[ -n ${TMUX:-} ]]; then
        exec tmux switch-client -t "=$session"
    fi
    exec tmux attach-session -t "=$session"
}

# Used locally and copied into the setup step so prompts remain interactive.
confirm() {
    local answer
    printf '\nAbout to run:\n%s\nRun this command? [y/N] ' "$1" >&2
    IFS= read -r answer || return 1
    case $answer in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

confirm_command() {
    local displayed
    printf -v displayed '%q ' "$@"
    confirm "$displayed"
}

# Preserve existing user configuration; repeated setup does not duplicate lines.
append_confirmed() {
    local file=$1 line=$2 displayed
    if [[ -f $file ]] && grep -Fqx -- "$line" "$file"; then return; fi
    [[ ! -e $file || -f $file ]] || fail "Not a regular file: $file"
    printf -v displayed "printf '\\n%%s\\n' %q >> %q" "$line" "$file"
    confirm "$displayed" || fail 'Setup stopped: command declined'
    printf '\n%s\n' "$line" >> "$file" || fail "Cannot update $file"
}

setup_main() {
    set -euo pipefail
    umask 077
    export SCRATCH_DIR=$1
    local project=$2 bin_dir=$3 zsh_path direnv installer install_command hook
    local venv_python kernel_name
    local shell_fallback=0
    cd -- "$project" || fail "Project directory is unavailable on this node: $project"
    [[ -d $bin_dir && -w $bin_dir ]] || fail "Binary directory must be shared and writable: $bin_dir"
    zsh_path=$(command -v zsh) || fail 'zsh is unavailable; load a cluster module providing zsh, then retry set-up'
    [[ $zsh_path = /* && -x $zsh_path ]] || fail 'zsh must resolve to an absolute executable path'
    [[ -d ${ZDOTDIR:-$HOME} ]] || fail 'ZDOTDIR must exist before set-up'
    direnv="$bin_dir/direnv"

    if [[ -e .venv || -L .venv ]]; then
        [[ -f .venv/pyvenv.cfg && -r .venv/bin/activate && -x .venv/bin/python ]] ||
            fail 'Existing .venv is incomplete; repair it or move it aside before retrying (nothing removed)'
        .venv/bin/python -c 'import sys; assert sys.prefix != sys.base_prefix' ||
            fail 'Existing .venv is not usable on this node; repair it or move it aside'
        printf 'Reusing existing .venv\n'
    else
        command -v python3 >/dev/null || fail 'python3 is unavailable; load a cluster Python module and retry'
        confirm_command python3 -m venv .venv || fail 'Setup stopped: command declined'
        python3 -m venv .venv ||
            fail 'venv creation failed; check Python venv/ensurepip support. Any partial .venv was retained'
    fi

    if [[ ! -x $direnv ]] || ! "$direnv" version >/dev/null 2>&1; then
        command -v curl >/dev/null || fail 'curl is required to install direnv'
        # Show the exact download and installation commands, including bin_path.
        # shellcheck disable=SC2016
        printf -v install_command 'installer=$(curl -sfL https://direnv.net/install.sh) && bin_path=%q bash <<< "$installer"' "$bin_dir"
        confirm "$install_command" || fail 'Setup stopped: command declined'
        installer=$(curl -sfL https://direnv.net/install.sh) || fail 'direnv download failed; retry when network access is available'
        [[ -n $installer ]] || fail 'direnv installer download was empty'
        bin_path="$bin_dir" bash <<< "$installer" || fail 'direnv installation failed; retry set-up after fixing the reported error'
        if [[ ! -x $direnv ]] || ! "$direnv" version >/dev/null 2>&1; then
            fail "direnv installer did not produce a working $direnv"
        fi
    fi

    if command -v chsh >/dev/null; then
        if confirm_command chsh -s "$zsh_path"; then
            if ! chsh -s "$zsh_path"; then
                printf 'chsh failed; offering a project-local SHELL fallback.\n' >&2
                shell_fallback=1
            fi
        else
            printf 'chsh declined; offering a project-local SHELL fallback.\n' >&2
            shell_fallback=1
        fi
    else
        printf 'chsh is unavailable; offering a project-local SHELL fallback.\n' >&2
        shell_fallback=1
    fi

    append_confirmed .envrc 'source .venv/bin/activate'
    printf -v hook 'PATH_add %q' "$bin_dir"
    append_confirmed .envrc "$hook"
    if ((shell_fallback)); then
        printf -v hook 'export SHELL=%q' "$zsh_path"
        append_confirmed .envrc "$hook"
    fi
    # Hook both shells, including accounts where changing the login shell fails.
    # Expanded by the user's shell when loading its startup file.
    # shellcheck disable=SC2016
    printf -v hook 'eval "$(%q hook zsh)"' "$direnv"
    append_confirmed "${ZDOTDIR:-$HOME}/.zshrc" "$hook"
    # shellcheck disable=SC2016
    printf -v hook 'eval "$(%q hook bash)"' "$direnv"
    append_confirmed "$HOME/.bashrc" "$hook"

    printf '\nReview %s/.envrc before allowing it:\n' "$project"
    cat -- .envrc
    confirm_command "$direnv" allow . || fail 'Setup stopped: .envrc not allowed; review it and run direnv allow manually'
    "$direnv" allow . || fail 'direnv allow failed; review .envrc and retry manually'

    venv_python="$project/.venv/bin/python"
    printf '\nOptional: install Jupyter Notebook and ipykernel in .venv for VS Code?\n'
    if confirm_command "$venv_python" -m pip install notebook ipykernel; then
        if ! "$venv_python" -m pip --version >/dev/null 2>&1; then
            confirm_command "$venv_python" -m ensurepip --upgrade || fail 'Jupyter installation stopped: pip bootstrap declined'
            "$venv_python" -m ensurepip --upgrade || fail 'pip bootstrap failed; use a Python installation with ensurepip support and retry'
        fi
        "$venv_python" -m pip install notebook ipykernel || fail 'Jupyter installation failed; check package-index access and retry set-up'
        # Stable per-project name avoids replacing another project's .venv kernel.
        kernel_name=$(printf '%s' "$project" | sha256sum)
        kernel_name="slurm-utils-${kernel_name:0:16}"
        confirm_command "$venv_python" -m ipykernel install --user --name "$kernel_name" \
            --display-name "Python (.venv: $project)" || fail 'Jupyter installed; kernel registration declined'
        "$venv_python" -m ipykernel install --user --name "$kernel_name" \
            --display-name "Python (.venv: $project)" || fail 'Jupyter installed; kernel registration failed; retry set-up'
    else
        printf 'Skipping optional Jupyter installation and kernel registration.\n'
    fi
    printf 'Setup complete in %s. Run slurm-utils connect from this directory.\n' "$project"
}

config="$HOME/.config/slurm-utils/config.sh"
caller_dir=$(pwd -P)
command_name=''
port_override=''
vmem_gb=''
while (($#)); do
    case $1 in
        --help|-h) help; exit 0 ;;
        --config) (($# >= 2)) || fail '--config needs a path'; config=$2; shift 2 ;;
        --vmem)
            (($# >= 2)) || fail '--vmem needs a positive integer in GB, e.g. --vmem 30'
            [[ -z $vmem_gb ]] || fail 'Specify --vmem only once'
            [[ $2 =~ ^([0-9]{1,6})([Gg]([Bb])?)?$ ]] || fail '--vmem must be a positive integer in GB'
            vmem_gb=$((10#${BASH_REMATCH[1]}))
            ((vmem_gb > 0)) || fail '--vmem must be positive'
            shift 2 ;;
        schedule|status|connect|set-up|jupyter|cancel)
            [[ -z $command_name ]] || fail 'Specify one command'
            command_name=$1; shift ;;
        *)
            if [[ $command_name = jupyter && -z $port_override ]]; then
                validate_port "$1"
                port_override=$1; shift
            else
                fail "Unknown argument: $1 (see --help)"
            fi
            ;;
    esac
done
[[ -n $command_name ]] || { help; exit 1; }
[[ -z $vmem_gb || $command_name = schedule ]] || fail '--vmem is only supported by schedule'
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/slurm-utils"
[[ $state_dir = /* ]] || fail 'State directory must be absolute'
mkdir -p -- "$state_dir"
[[ -O $state_dir && ! -L $state_dir ]] || fail 'State directory must be owned by you and not a symlink'
chmod 700 -- "$state_dir"

load_current() {
    [[ -f $state_dir/current ]] || fail 'No current allocation; run slurm-utils schedule'
    # shellcheck disable=SC1091
    source "$state_dir/current"
    [[ $JOB_ID =~ ^[0-9]+$ && $LAUNCH_DIR = "$state_dir/"* ]] || fail 'Invalid saved state'
    # shellcheck disable=SC1091
    source "$LAUNCH_DIR/settings.sh"
}
query() {
    local output id state node
    output=$(squeue --noheader --user "$(id -un)" --format='%i|%T|%N') ||
        fail 'Slurm query failed; saved state preserved'
    JOB_STATE=FINISHED
    JOB_NODE=''
    while IFS='|' read -r id state node; do
        if [[ $id = "$JOB_ID" ]]; then JOB_STATE=$state; JOB_NODE=$node; break; fi
    done <<< "$output"
}
finished() {
    case $JOB_STATE in
        FINISHED|COMPLETED|CANCELLED|FAILED|TIMEOUT|NODE_FAIL|OUT_OF_MEMORY|BOOT_FAIL|DEADLINE|PREEMPTED) return 0 ;;
        *) return 1 ;;
    esac
}
validate_config() {
    local name root declaration
    for name in JOB_NAME PARTITION GRES CPUS_PER_TASK MEMORY TIME_LIMIT LOG_DIR SCRATCH_ROOTS; do
        [[ ${!name+x} ]] || fail "Configuration must define $name (PARTITION and GRES may be empty)"
    done
    if declare -p GPU_MEMORY_GB >/dev/null 2>&1; then
        declaration=$(declare -p GPU_MEMORY_GB)
        [[ $declaration = 'declare -A '* ]] || fail 'GPU_MEMORY_GB must be an associative array'
        for name in "${!GPU_MEMORY_GB[@]}"; do
            [[ $name =~ ^[a-zA-Z0-9_.-]+$ && ${GPU_MEMORY_GB[$name]} =~ ^[1-9][0-9]{0,5}$ ]] ||
                fail 'GPU_MEMORY_GB must map GPU type names to positive integer GB capacities'
        done
    fi
    JUPYTER_PORT=${JUPYTER_PORT-1234}
    for name in JOB_NAME MEMORY TIME_LIMIT LOG_DIR; do
        [[ -n ${!name} && ${!name} != *$'\n'* ]] || fail "Invalid $name"
    done
    [[ $CPUS_PER_TASK =~ ^[1-9][0-9]*$ ]] || fail 'CPUS_PER_TASK must be a positive integer'
    [[ $MEMORY =~ ^[0-9]+([KkMmGgTt])?$ ]] || fail 'MEMORY must be a Slurm size, e.g. 16G'
    [[ $TIME_LIMIT =~ ^[0-9]+(-[0-9]+)?(:[0-9]+){0,2}$ ]] || fail 'Invalid TIME_LIMIT'
    validate_port "$JUPYTER_PORT"
    [[ $LOG_DIR = /* && $LOG_DIR != *%* ]] || fail 'LOG_DIR must be absolute and contain no %'
    declaration=$(declare -p SCRATCH_ROOTS)
    [[ $declaration = 'declare -a '* && ${#SCRATCH_ROOTS[@]} -gt 0 ]] || fail 'SCRATCH_ROOTS must be a nonempty Bash array'
    for root in "${SCRATCH_ROOTS[@]}"; do
        [[ $root = /* && $root != *$'\n'* ]] || fail 'Scratch roots must be absolute single-line paths'
    done
    KEYTAB=${KEYTAB:-}
    ENV_SETUP=${ENV_SETUP:-}
    [[ -z $KEYTAB || $KEYTAB = /* ]] || fail 'KEYTAB must be absolute'
    [[ -z $ENV_SETUP || ( $ENV_SETUP = /* && -r $ENV_SETUP ) ]] || fail 'ENV_SETUP must be an absolute readable file'
    mkdir -p -- "$LOG_DIR"
    [[ -w $LOG_DIR ]] || fail 'LOG_DIR is not writable'
}


# Slurm advertises GPU types, not portable VRAM capacities. Recognize explicit
# capacity suffixes (including MIG profiles), then exact known models. Unknown
# types are excluded unless the site supplies GPU_MEMORY_GB in its trusted config.
gpu_memory_gb() {
    local type=$1 model=${1#nvidia_}
    if declare -p GPU_MEMORY_GB >/dev/null 2>&1 && [[ -n ${GPU_MEMORY_GB[$type]:-} ]]; then
        printf '%s\n' "${GPU_MEMORY_GB[$type]}"
    elif [[ $type =~ (^|[_.-])([1-9][0-9]{0,5})gb$ ]]; then
        printf '%s\n' "${BASH_REMATCH[2]}"
    else
        case $model in
            a40|l40|l40s|rtx_a6000|rtx_6000_ada_generation) printf '48\n' ;;
            h200|h200_nvl) printf '141\n' ;;
            rtx_pro_6000_blackwell_server_edition|rtx_pro_6000_blackwell_workstation_edition)
                printf '96\n' ;;
            *) return 1 ;;
        esac
    fi
}

select_vmem_gpu() {
    local inventory entries entry type capacity count=1 estimate start
    local best_start='' best_gres='' best_capacity='' best_type='' i
    local LC_ALL=C
    local -a inventory_args=(--noheader --format=%G) candidates=() capacities=()
    local -A seen_types=()
    # --vmem replaces only a single GPU request, preserving its count.
    if [[ -n $GRES ]]; then
        [[ $GRES =~ ^gpu(:[a-zA-Z0-9_.-]+)?:([1-9][0-9]*)$ ]] ||
            fail '--vmem requires GRES to be empty or a single gpu[:type]:count request'
        count=${BASH_REMATCH[2]}
    fi
    [[ -z $PARTITION ]] || inventory_args+=("--partition=$PARTITION")
    inventory=$(sinfo "${inventory_args[@]}") || fail 'GPU inventory query failed; no job submitted'
    # Remove topology annotations before splitting the comma-separated GRES list.
    entries=$(printf '%s\n' "$inventory" | sed 's/([^)]*)//g' | tr ',' '\n' | LC_ALL=C sort -u)
    while IFS= read -r entry; do
        [[ $entry =~ ^[[:space:]]*gpu:([a-zA-Z0-9_.-]+):[1-9][0-9]*[[:space:]]*$ ]] || continue
        type=${BASH_REMATCH[1]}
        [[ -z ${seen_types[$type]:-} ]] || continue
        seen_types[$type]=1
        if ! capacity=$(gpu_memory_gb "$type"); then
            printf 'Skipping GPU %s: unknown VRAM capacity (set GPU_MEMORY_GB in config).\n' "$type" >&2
            continue
        fi
        if ((capacity >= vmem_gb)); then
            candidates+=("gpu:$type:$count")
            capacities+=("$capacity")
        fi
    done <<< "$entries"
    ((${#candidates[@]} > 0)) || fail "No advertised GPU type meets --vmem $vmem_gb GB; no job submitted"
    printf 'Considering GPUs with at least %s GB VRAM per GPU (count %s):\n' "$vmem_gb" "$count" >&2
    for i in "${!candidates[@]}"; do
        printf '  %s (%s GB per GPU)\n' "${candidates[$i]}" "${capacities[$i]}" >&2
    done
    for i in "${!candidates[@]}"; do
        if ! estimate=$(LC_ALL=C TZ=UTC SLURM_TIME_FORMAT=standard sbatch --test-only "${args[@]}" \
            "--gres=${candidates[$i]}" "$LAUNCH_DIR/batch.sh" 2>&1); then
            printf '  %s: estimate unavailable: %s\n' "${candidates[$i]}" "$estimate" >&2
            continue
        fi
        if [[ $estimate =~ to\ start\ at\ ([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}) ]]; then
            start=${BASH_REMATCH[1]}
            printf '  %s: estimated start %s UTC\n' "${candidates[$i]}" "$start" >&2
            type=${candidates[$i]#gpu:}
            type=${type%:*}
            # Compare type names, not full GRES records: ':' changes prefix order.
            if [[ -z $best_start || $start < $best_start ||
                ( $start = "$best_start" && $type < $best_type ) ]]; then
                best_start=$start
                best_gres=${candidates[$i]}
                best_capacity=${capacities[$i]}
                best_type=$type
            fi
        else
            printf '  %s: no usable start estimate: %s\n' "${candidates[$i]}" "$estimate" >&2
        fi
    done
    [[ -n $best_gres ]] || fail 'No qualifying GPU has a scheduling estimate; no job submitted'
    GRES=$best_gres
    printf 'Chosen GPU: %s (%s GB per GPU); expected start %s UTC.\n' "$GRES" "$best_capacity" "$best_start" >&2
    printf 'Start time is an estimate; the submitted GPU type remains fixed while queued.\n' >&2
}

case $command_name in
    schedule)
        exec 9> "$state_dir/lock"
        flock -x 9
        if [[ -f $state_dir/current ]]; then
            load_current; query
            finished || fail "Allocation $JOB_ID is still $JOB_STATE"
        fi
        # Clear previous settings and inherited configuration values.
        unset GPU_MEMORY_GB JOB_NAME PARTITION GRES CPUS_PER_TASK MEMORY TIME_LIMIT LOG_DIR SCRATCH_ROOTS KEYTAB ENV_SETUP JUPYTER_PORT
        [[ -r $config ]] || fail "Missing configuration: $config; copy config.example.sh there and edit it"
        # shellcheck disable=SC1090
        source "$config"
        validate_config
        LAUNCH_DIR=$(mktemp -d "$state_dir/launch.XXXXXXXX")
        LAUNCH_USER=$(id -un)
        {
            for name in JOB_NAME PARTITION GRES CPUS_PER_TASK MEMORY TIME_LIMIT LOG_DIR KEYTAB ENV_SETUP JUPYTER_PORT LAUNCH_USER; do
                printf '%s=%q\n' "$name" "${!name}"
            done
            printf 'SCRATCH_ROOTS=('
            printf ' %q' "${SCRATCH_ROOTS[@]}"
            printf ' )\n'
        } > "$LAUNCH_DIR/settings.sh"
        {
            printf '#!/usr/bin/env bash\nset -euo pipefail\numask 077\nLAUNCH_DIR=%q\n' "$LAUNCH_DIR"
            # Expand on the compute node, not while generating the script.
            # shellcheck disable=SC2016
            printf 'source "$LAUNCH_DIR/settings.sh"\n'
            declare -f batch_main
            printf 'batch_main\n'
        } > "$LAUNCH_DIR/batch.sh"
        # JOB_NAME is supplied by the validated configuration.
        # shellcheck disable=SC2153
        args=(--parsable --nodes=1 --ntasks=1 "--job-name=$JOB_NAME"
            "--cpus-per-task=$CPUS_PER_TASK" "--mem=$MEMORY" "--time=$TIME_LIMIT"
            "--output=$LOG_DIR/slurm-utils-%j.out" "--error=$LOG_DIR/slurm-utils-%j.err"
            "--chdir=$HOME" --export=ALL)
        [[ -z $PARTITION ]] || args+=("--partition=$PARTITION")
        if [[ -n $vmem_gb ]]; then
            select_vmem_gpu
            # Snapshot the actual typed request selected before the only submission.
            printf 'GRES=%q\n' "$GRES" >> "$LAUNCH_DIR/settings.sh"
        fi
        [[ -z $GRES ]] || args+=("--gres=$GRES")
        result=$(sbatch "${args[@]}" "$LAUNCH_DIR/batch.sh") || fail 'Submission failed; previous state preserved'
        [[ $result =~ ^([0-9]+)(\;[a-zA-Z0-9_.-]+)?$ ]] ||
            fail "Unexpected sbatch output: $result; inspect squeue before retrying (job may have been submitted)"
        JOB_ID=${BASH_REMATCH[1]}
        temp=$(mktemp "$state_dir/.current.XXXXXX")
        printf 'JOB_ID=%q\nLAUNCH_DIR=%q\n' "$JOB_ID" "$LAUNCH_DIR" > "$temp"
        mv -- "$temp" "$state_dir/current"
        printf 'Scheduled allocation %s\n' "$JOB_ID"
        ;;
    cancel)
        exec 9> "$state_dir/lock"
        flock -x 9
        load_current
        scancel "$JOB_ID" || fail 'Cancellation failed; saved state preserved'
        rm -- "$state_dir/current"
        printf 'Cancelled allocation %s; scratch data retained\n' "$JOB_ID"
        ;;
    status|connect|set-up|jupyter)
        load_current; query
        scratch=''
        [[ ! -f $LAUNCH_DIR/scratch-$JOB_ID ]] || IFS= read -r scratch < "$LAUNCH_DIR/scratch-$JOB_ID"
        if [[ $command_name = status ]]; then
            printf 'Job: %s\nState: %s\nNode: %s\nScratch: %s\nStdout: %s/slurm-utils-%s.out\nStderr: %s/slurm-utils-%s.err\n' \
                "$JOB_ID" "$JOB_STATE" "${JOB_NODE:--}" "${scratch:-initializing; retry shortly}" "$LOG_DIR" "$JOB_ID" "$LOG_DIR" "$JOB_ID"
            exit 0
        fi
        [[ $JOB_STATE = RUNNING ]] || fail "Allocation $JOB_ID is $JOB_STATE; a running allocation is required"
        [[ -n $scratch ]] || fail 'Allocation initializing; retry shortly'
        step=(srun --jobid "$JOB_ID" --overlap --nodes=1 --ntasks=1 --export=ALL)
        if [[ $command_name = set-up ]]; then
            binary=$(readlink -f -- "${BASH_SOURCE[0]}")
            bin_dir=$(dirname -- "$binary")
            # Keep the step script in private shared state, like the batch script.
            # A file also lets the prompt show the complete, runnable srun command.
            setup_script=$(mktemp "$LAUNCH_DIR/setup.XXXXXX")
            {
                declare -f fail confirm confirm_command append_confirmed setup_main
                printf 'setup_main "$@"\n'
            } > "$setup_script"
            confirm_command "${step[@]}" --chdir="$caller_dir" --pty bash "$setup_script" \
                "$scratch" "$caller_dir" "$bin_dir" || fail 'Setup connection declined'
            exec "${step[@]}" --chdir="$caller_dir" --pty bash "$setup_script" "$scratch" "$caller_dir" "$bin_dir"
        fi
        if [[ $command_name = connect ]]; then
            # Positional parameters are expanded by the remote Bash.
            # shellcheck disable=SC2016
            connection=("${step[@]}" --chdir="$caller_dir" --pty bash -c '
                # The tmux server lives on the login node, not this node.
                unset TMUX TMUX_PANE
                export SCRATCH_DIR=$1
                cd -- "$2" || { echo "Project directory unavailable: $2" >&2; exit 1; }
                if command -v zsh >/dev/null; then
                    export SHELL=$(command -v zsh)
                    exec "$SHELL" --login
                fi
                echo "zsh unavailable; falling back to Bash" >&2
                exec bash --login
            ' bash "$scratch" "$caller_dir")
            if command -v tmux >/dev/null; then
                connect_tmux "${connection[@]}"
            fi
            exec "${connection[@]}"
        fi
        # Positional parameters and token generation belong to the remote Bash.
        # shellcheck disable=SC2016
        exec "${step[@]}" --chdir="$caller_dir" bash -c '
            set -euo pipefail
            export SCRATCH_DIR=$1
            jupyter_command=jupyter
            if [[ -n $2 ]]; then
                source "$2"
            elif [[ -x $4/.venv/bin/jupyter ]]; then
                export VIRTUAL_ENV="$4/.venv"
                export PATH="$VIRTUAL_ENV/bin:$PATH"
                jupyter_command="$VIRTUAL_ENV/bin/jupyter"
            fi
            token=$(od -An -N32 -tx1 /dev/urandom | tr -d " \n")
            [[ ${#token} = 64 ]] || { echo "Token generation failed" >&2; exit 1; }
            export JUPYTER_TOKEN=$token
            printf "Jupyter URL (once ready): http://%s:%s/?token=%s\n" "$(hostname -f)" "$3" "$token"
            exec "$jupyter_command" notebook --no-browser --ip=0.0.0.0 --port="$3" --port-retries=0
        ' bash "$scratch" "$ENV_SETUP" "${port_override:-$JUPYTER_PORT}" "$caller_dir"
        ;;
esac
